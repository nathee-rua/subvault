# SubVault Environment Variables Template
# Server-side Application Secrets (Configure in Vercel Environment Variables / .env.local)

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Data Encryption Key (32-byte hex string)
VAULT_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-placeholder

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-placeholder
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-placeholder

# Automated Cron Services
CRON_SECRET=your-cron-secret-token-placeholder

# Third-party Integrations (Server-side only)
OPENAI_API_KEY=sk-your-openai-api-key-placeholder
GEMINI_API_KEY=your-gemini-api-key-placeholder
RESEND_API_KEY=re_your_resend_api_key_placeholder
