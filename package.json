{
  "name": "subvault-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix app-temp run dev",
    "build": "npm --prefix app-temp run build",
    "start": "npm --prefix app-temp run start",
    "lint": "npm --prefix app-temp run lint",
    "test": "npm --prefix app-temp run test",
    "typecheck": "npm --prefix app-temp run typecheck",
    "security:boundaries": "node app-temp/scripts/check-secret-boundaries.mjs",
    "secrets:check": "npx gitleaks dir . --config .gitleaks.toml --redact --exit-code 1 --no-banner",
    "secrets:history": "npx gitleaks git . --config .gitleaks.toml --redact --exit-code 1 --no-banner",
    "security:check": "npm run security:boundaries && npm run secrets:check",
    "db:test": "supabase test db",
    "e2e:guard": "node scripts/assert-e2e-safe-env.mjs",
    "e2e": "node scripts/assert-e2e-safe-env.mjs && playwright test",
    "e2e:ui": "node scripts/assert-e2e-safe-env.mjs && playwright test --ui",
    "e2e:headed": "node scripts/assert-e2e-safe-env.mjs && playwright test --headed",
    "e2e:report": "playwright show-report tests/e2e/reports/html",
    "e2e:smoke": "node scripts/assert-e2e-safe-env.mjs && playwright test --grep \"@smoke\"",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@b12k/gitleaks": "^8.30.1-v.20",
    "@playwright/test": "^1.50.0"
  }
}
