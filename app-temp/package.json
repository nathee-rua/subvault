{
  "name": "subvault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:boundaries": "node scripts/check-secret-boundaries.mjs",
    "secrets:check": "npx gitleaks dir . --config ../.gitleaks.toml --redact --exit-code 1 --no-banner",
    "secrets:history": "npx gitleaks git .. --config ../.gitleaks.toml --redact --exit-code 1 --no-banner",
    "security:check": "npm run security:boundaries && npm run secrets:check",
    "db:test": "supabase test db",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@b12k/gitleaks": "^8.30.1-v.20",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
